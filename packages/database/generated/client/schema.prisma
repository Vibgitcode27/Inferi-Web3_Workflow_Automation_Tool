datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  Feri      Feri[]
}

model Feri {
  id        String    @id @default(uuid())
  userId    Int
  name      String
  status    Boolean
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trigger   Trigger?
  action    Action[]
  FeriRuns  FeriRun[]
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
}

model FeriRun {
  id         String       @id @default(uuid())
  feriId     String
  status     String
  metadata   Json
  feri       Feri?        @relation(fields: [feriId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feriOutbox FeriOutbox[]
  updatedAt  DateTime[]
  createdAt  DateTime     @default(now())
}

model FeriOutbox {
  id        String   @id @default(uuid())
  metadata  Json
  feriRunId String
  status    String
  FeriRun   FeriRun  @relation(fields: [feriRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Trigger {
  id                 String           @id @default(uuid())
  availableTriggerId String
  feriId             String           @unique
  type               AvailableTrigger @relation(fields: [availableTriggerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feri               Feri             @relation(fields: [feriId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedAt          DateTime         @updatedAt
  createdAt          DateTime         @default(now())
}

model Action {
  id                String           @id @default(uuid())
  availableActionId String
  feriId            String
  type              AvailableActions @relation(fields: [availableActionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feri              Feri             @relation(fields: [feriId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedAt         DateTime         @updatedAt
  createdAt         DateTime         @default(now())
  sortingOrder      Int              @default(0)
}

model AvailableActions {
  id          String   @id @default(uuid())
  appId       String   @unique // 'sheets', 'slack', 'notion', 'github'
  name        String // 'Google Sheets', 'Slack', etc.
  icon        String? // URL or path to icon
  description String?
  metadata    Json? // Store the actions array: [{ id: 'create_row', name: 'Create Row', description: '...' }]
  Action      Action[]
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AvailableTrigger {
  id          String    @id @default(uuid())
  appId       String    @unique // 'webhook', etc.
  name        String // 'Webhook'
  icon        String? // URL or path to icon
  description String?
  metadata    Json? // Store the events array: [{ id: 'webhook_called', name: 'Webhook Called', description: '...' }]
  Trigger     Trigger[]
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}
